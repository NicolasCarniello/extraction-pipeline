# Copiá este archivo como .env y completá tus valores:  cp .env.example .env
# El .env está en .gitignore: NUNCA lo subas al repositorio.

# Proveedor activo: openai | anthropic
LLM_PROVIDER=openai

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# Alternativa más económica para pruebas: claude-haiku-5-5
ANTHROPIC_MODEL=claude-opus-5-5

# Opcionales
# LLM_TEMPERATURE=0        # solo OpenAI (Claude no acepta temperature)
# LLM_MAX_TOKENS=4096      # muy bajo → JSON truncado
